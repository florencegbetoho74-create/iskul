# Variables publiques de l'app Expo (mobile + web).
# Elles sont inlinees dans le bundle au moment du build : sur Vercel,
# declare-les dans Settings > Environment Variables, sinon l'app se charge
# mais reste sans Supabase (connexion impossible).

EXPO_PUBLIC_SUPABASE_URL=https://<ref>.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_SUPABASE_BUCKET=iskul

# Classes live (Agora)
EXPO_PUBLIC_AGORA_APP_ID=

# Optionnel : endpoint de jeton Agora. Sans lui, la fonction Supabase
# "agora-token" est appelee.
# EXPO_PUBLIC_AGORA_TOKEN_URL=
# EXPO_PUBLIC_AGORA_TOKEN_FUNCTION=agora-token

EXPO_PUBLIC_USE_STUDENT_HOME_FUNCTION=false
