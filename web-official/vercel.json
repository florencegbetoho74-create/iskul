{
  "headers": [
    {
      "source": "/espace-professeur",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/espace-professeur/(.*)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/console",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" }]
    },
    {
      "source": "/console/(.*)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" }]
    }
  ],
  "rewrites": [
    { "source": "/console", "destination": "/console.html" },
    { "source": "/console/(.*)", "destination": "/console.html" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
